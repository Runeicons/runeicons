{
  "name": "runeicons-react",
  "version": "0.1.1",
  "description": "React components for RuneIcons: 350+ icons, 900+ variants across five styles.",
  "keywords": [
    "icons",
    "svg",
    "icon-set",
    "react",
    "react-component",
    "duotone",
    "pixelated",
    "glass",
    "runeicons",
    "brand-logos"
  ],
  "homepage": "https://runeicons.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runeicons/runeicons.git",
    "directory": "packages/runeicons-react"
  },
  "bugs": "https://github.com/Runeicons/runeicons/issues",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "default": "./dist/icons/*.js"
    },
    "./brands": {
      "types": "./dist/brands.d.ts",
      "default": "./dist/brands.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "bun run scripts/build.ts && bun run scripts/build-brands.ts",
    "build": "bun run generate && rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun run generate && bun run typecheck && bun test",
    "prepublishOnly": "bun run build && bun run typecheck && bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
